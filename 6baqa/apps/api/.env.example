# --- Database (required) ---
# Railway Postgres connection string, e.g. postgresql://user:pass@host:port/db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/6baqa?schema=public"

# --- Admin auth (required) ---
# Preferred: a bcrypt hash. Generate one with:
#   npm run hash-password --workspace @6baqa/api -- 'your-password'
ADMIN_PASSWORD_HASH=""
# Fallback (plaintext) if you don't set a hash. Use ONE of the two.
# ADMIN_PASSWORD="change-me"

# Secret used to sign admin JWTs. Set a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# --- Uploads / object storage ---
# Preferred in production: an S3-compatible bucket (Railway Bucket, MinIO, R2,
# AWS S3). When these are set, uploads go to the bucket. Railway injects the
# AWS_* names automatically when you reference a Bucket service; the S3_* names
# below are optional overrides and take precedence.
#
#   AWS_ENDPOINT_URL / S3_ENDPOINT              bucket endpoint URL
#   AWS_ACCESS_KEY_ID / S3_ACCESS_KEY_ID
#   AWS_SECRET_ACCESS_KEY / S3_SECRET_ACCESS_KEY
#   AWS_S3_BUCKET_NAME / S3_BUCKET
#   AWS_DEFAULT_REGION / S3_REGION              (default: auto)
#   AWS_S3_URL_STYLE / S3_URL_STYLE             path | virtual (default: path)
#
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET=""
# S3_REGION="auto"
#
# Optional: if the bucket serves objects publicly, set its public base URL and
# image links point straight at it. Otherwise downloads are proxied by the API
# at /api/uploads/<key> (works with private buckets).
# S3_PUBLIC_URL=""
#
# Local dev fallback when no bucket is configured: uploads are written here.
# UPLOADS_DIR="./uploads"

# --- Server (optional) ---
# PORT is injected by Railway; defaults to 3000 locally.
# PORT=3000
