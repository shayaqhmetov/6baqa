# --- Database (required) ---
# Railway Postgres connection string, e.g. postgresql://user:pass@host:port/db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/6baqa?schema=public"

# --- Admin auth (required) ---
# Preferred: a bcrypt hash. Generate one with:
#   npm run hash-password --workspace @6baqa/api -- 'your-password'
ADMIN_PASSWORD_HASH=""
# Fallback (plaintext) if you don't set a hash. Use ONE of the two.
# ADMIN_PASSWORD="change-me"

# Secret used to sign admin JWTs. Set a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# --- Uploads / object storage ---
# Preferred in production: an S3-compatible bucket (Railway Bucket, MinIO, R2,
# AWS S3). Uploads go to the bucket when it's configured. Uses the AWS_* names
# (what a Railway Bucket injects) — reference them from the bucket service:
#
# AWS_ENDPOINT_URL="${{Bucket.AWS_ENDPOINT_URL}}"
# AWS_ACCESS_KEY_ID="${{Bucket.AWS_ACCESS_KEY_ID}}"
# AWS_SECRET_ACCESS_KEY="${{Bucket.AWS_SECRET_ACCESS_KEY}}"
# AWS_S3_BUCKET_NAME="${{Bucket.AWS_S3_BUCKET_NAME}}"
# AWS_REGION="${{Bucket.AWS_REGION}}"
#
# Generic S3_* overrides also work (MinIO / R2 / AWS):
#   S3_ENDPOINT  S3_ACCESS_KEY_ID  S3_SECRET_ACCESS_KEY  S3_BUCKET  S3_REGION
#
# Addressing style: default is "virtual" (Railway Buckets). Set to "path" for
# MinIO / older buckets.
# AWS_S3_URL_STYLE="path"
#
# Optional: if the bucket serves objects publicly, set its public base URL and
# image links point straight at it. Otherwise downloads are proxied by the API
# at /api/uploads/<key> (the default; works with private buckets).
# AWS_S3_URL=""
#
# Local dev fallback when no bucket is configured: uploads are written here.
# UPLOADS_DIR="./uploads"

# --- Server (optional) ---
# PORT is injected by Railway; defaults to 3000 locally.
# PORT=3000
