# --- Database (required) ---
# Postgres connection string, e.g. postgresql://user:pass@host:port/db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/6baqa?schema=public"

# --- Admin auth (required) ---
# Preferred: a bcrypt hash. Generate one with:
#   npm run hash-password --workspace @6baqa/api -- 'your-password'
ADMIN_PASSWORD_HASH=""
# Fallback (plaintext) if you don't set a hash. Use ONE of the two.
# ADMIN_PASSWORD="change-me"

# Secret used to sign admin JWTs. Set a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# --- Uploads / object storage ---
# Uploads are written to disk here when no bucket is configured. In production
# (Coolify) this points at a persistent volume: UPLOADS_DIR="/data/uploads".
# UPLOADS_DIR="./uploads"
#
# Optional: an S3-compatible bucket (MinIO, R2, AWS S3). Uploads go to the
# bucket when it's configured. AWS_* names or generic S3_* overrides:
#   S3_ENDPOINT  S3_ACCESS_KEY_ID  S3_SECRET_ACCESS_KEY  S3_BUCKET  S3_REGION
#
# Addressing style: default is "virtual". Set to "path" for MinIO.
# AWS_S3_URL_STYLE="path"
#
# If the bucket serves objects publicly, set its public base URL and image
# links point straight at it. Otherwise downloads are proxied by the API at
# /api/uploads/<key> (works with private buckets).
# AWS_S3_URL=""

# --- Server (optional) ---
# Defaults to 3000.
# PORT=3000
